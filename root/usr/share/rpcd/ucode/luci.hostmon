// SPDX-License-Identifier: Apache-2.0
//
// rpcd ucode backend for luci-app-hostmon: per-host traffic monitor.
//
//  rate   - byte/packet counters for one IPv4 host from a private nftables
//           table (inet luci_hostmon). Rules are added on first request and
//           removed after IDLE_SECS without a request, so nothing is left
//           counting once the page is closed.
//  conns  - the host's current conntrack entries.
//  host   - lease, static lease, bridge port, nlbwmon totals and top
//           protocols/ports, Snort alerts and addrwatch sightings.
//  crowdsec - CrowdSec decisions for the host (slow, so separate).

'use strict';

import { popen, readfile, writefile, mkdir, unlink, stat, lsdir, open } from 'fs';
import { cursor } from 'uci';

const TABLE = 'luci_hostmon';
const STATE = '/tmp/luci-hostmon';
const IDLE_SECS = 300;
const MAX_CONNS = 400;

function run(cmd) {
	const p = popen(cmd, 'r');
	if (!p)
		return '';
	const out = p.read('all') ?? '';
	p.close();
	return out;
}

function jrun(cmd) {
	try { return json(run(cmd)); } catch (e) { return null; }
}

// Strict dotted-quad IPv4; nothing else ever reaches a shell or nft.
function valid_ip(ip) {
	if (type(ip) != 'string')
		return false;

	const m = match(ip, /^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/);
	if (!m)
		return false;

	for (let i = 1; i <= 4; i++)
		if (int(m[i]) > 255)
			return false;

	return true;
}

function uptime() {
	return +(split(trim(readfile('/proc/uptime') ?? '0'), ' ')[0]);
}

// ---------------------------------------------------------------- nft rate counters

function ensure_table() {
	if (system(`nft list table inet ${TABLE} >/dev/null 2>&1`) == 0)
		return;

	writefile(`${STATE}/table.nft`,
		`table inet ${TABLE} {\n` +
		`  chain hm_forward { type filter hook forward priority filter - 5; policy accept; }\n` +
		`  chain hm_input { type filter hook input priority filter - 5; policy accept; }\n` +
		`  chain hm_output { type filter hook output priority filter - 5; policy accept; }\n` +
		`}\n`);
	system(`nft -f ${STATE}/table.nft >/dev/null 2>&1`);
}

function list_rules() {
	const rules = [];
	const j = jrun(`nft -j list table inet ${TABLE} 2>/dev/null`);

	for (let e in j?.nftables ?? []) {
		const r = e?.rule;
		if (!r || !r.comment)
			continue;

		const m = match(r.comment, /^hm (\S+) (rx|tx)$/);
		if (!m)
			continue;

		let bytes = 0, packets = 0;
		for (let x in r.expr ?? [])
			if (x?.counter) {
				bytes = x.counter.bytes;
				packets = x.counter.packets;
			}

		push(rules, { ip: m[1], dir: m[2], chain: r.chain, handle: r.handle, bytes: bytes, packets: packets });
	}

	return rules;
}

function add_rules(ip) {
	let cmds = '';

	for (let chain in [ 'hm_forward', 'hm_input', 'hm_output' ]) {
		cmds += `add rule inet ${TABLE} ${chain} ip saddr ${ip} counter comment "hm ${ip} tx"\n`;
		cmds += `add rule inet ${TABLE} ${chain} ip daddr ${ip} counter comment "hm ${ip} rx"\n`;
	}

	writefile(`${STATE}/add.nft`, cmds);
	system(`nft -f ${STATE}/add.nft >/dev/null 2>&1`);
}

// Drop counters for hosts nobody has looked at recently; drop the table when empty.
function garbage_collect(rules) {
	const now = time();
	let left = 0;

	for (let r in rules) {
		const st = stat(`${STATE}/seen.${r.ip}`);
		if (st && now - st.mtime < IDLE_SECS) {
			left++;
			continue;
		}

		system(`nft delete rule inet ${TABLE} ${r.chain} handle ${int(r.handle)} >/dev/null 2>&1`);
		unlink(`${STATE}/seen.${r.ip}`);
	}

	if (!left)
		system(`nft delete table inet ${TABLE} >/dev/null 2>&1`);
}

// ---------------------------------------------------------------- helpers for host()

function lease_for(ip) {
	for (let l in split(readfile('/tmp/dhcp.leases') ?? '', '\n')) {
		const f = split(l, ' ');
		if (f[2] == ip)
			return { expires: int(f[0]), mac: lc(f[1]), hostname: f[3] != '*' ? f[3] : null };
	}

	return null;
}

function static_for(ip, mac) {
	const c = cursor();
	let found = null;

	c.foreach('dhcp', 'host', (s) => {
		const macs = type(s.mac) == 'array' ? s.mac : split(s.mac ?? '', ' ');
		if (s.ip == ip || (mac && index(map(macs, lc), mac) >= 0))
			found = { name: s.name, ip: s.ip, mac: join(' ', macs) };
	});

	return found;
}

function neigh_for(ip) {
	const m = match(run(`ip -4 neigh show ${ip} 2>/dev/null`), /dev (\S+) lladdr (\S+) (\S+)/);
	return m ? { dev: m[1], mac: lc(m[2]), state: m[3] } : null;
}

// Which bridge port the MAC was last seen on (brctl showmacs + brif port numbers).
function port_for(mac) {
	if (!mac)
		return null;

	for (let br in lsdir('/sys/class/net') ?? []) {
		const brif = lsdir(`/sys/class/net/${br}/brif`);
		if (!brif)
			continue;

		const ports = {};
		for (let p in brif)
			ports[int(replace(trim(readfile(`/sys/class/net/${br}/brif/${p}/port_no`) ?? '0'), /^0x/, ''), 16)] = p;

		for (let l in split(run(`brctl showmacs ${br} 2>/dev/null`), '\n')) {
			const f = split(trim(l), /\s+/);
			if (lc(f[1] ?? '') == mac && f[2] == 'no')
				return { bridge: br, port: ports[int(f[0])] ?? f[0], ageing: f[3] };
		}
	}

	return null;
}

function nlbw(ip) {
	const res = { total: null, top: [] };
	const t = jrun(`nlbw -c json -g ip 2>/dev/null`);

	for (let r in t?.data ?? [])
		if (r[0] == ip)
			res.total = { conns: r[1], rx_bytes: r[2], rx_pkts: r[3], tx_bytes: r[4], tx_pkts: r[5] };

	const g = jrun(`nlbw -c json -g ip,proto,port 2>/dev/null`);
	const rows = [];

	for (let r in g?.data ?? [])
		if (r[2] == ip)
			push(rows, { proto: r[0], port: r[1], conns: r[3], rx_bytes: r[4], tx_bytes: r[6] });

	res.top = slice(sort(rows, (a, b) => (b.rx_bytes + b.tx_bytes) - (a.rx_bytes + a.tx_bytes)), 0, 15);
	return res;
}

function snort_alerts(ip) {
	const c = cursor();
	const dir = c.get('snort', 'snort', 'log_dir') ?? '/var/log';
	const fh = open(`${dir}/alert_json.txt`, 'r');
	const out = [];
	let total = 0;

	if (!fh)
		return { total: 0, recent: [] };

	for (let l = fh.read('line'); length(l); l = fh.read('line')) {
		if (index(l, `"${ip}"`) < 0)
			continue;

		let a;
		try { a = json(l); } catch (e) { continue; }

		if (a.src_addr != ip && a.dst_addr != ip)
			continue;

		total++;
		push(out, { time: a.timestamp, msg: a.msg, src: a.src_addr, sport: a.src_port, dst: a.dst_addr, dport: a.dst_port, proto: a.proto, sid: a.sid, priority: a.priority });
		if (length(out) > 20)
			shift(out);
	}

	fh.close();
	return { total: total, recent: reverse(out) };
}

function addrwatch(ip, mac) {
	const seen = [];

	for (let l in split(run(`logread -e addrwatch 2>/dev/null | grep -F ' ${ip} ' | tail -n 200`), '\n')) {
		const m = match(l, /^(\w{3} \w{3} +\d+ [\d:]+ \d{4}) .*addrwatch: \d+ (\S+) \d+ (\S+) (\S+) (\S+)$/);
		if (m && m[4] == ip)
			push(seen, { time: m[1], iface: m[2], mac: lc(m[3]), type: m[5] });
	}

	const macs = {};
	for (let s in seen)
		macs[s.mac] = true;

	return {
		first: seen[0]?.time, last: seen[-1]?.time, count: length(seen),
		other_macs: filter(keys(macs), (m) => m != mac)
	};
}

// ---------------------------------------------------------------- name resolution

const QUERYLOG_LINES = 4000;
const PTR_TTL = 3600;
const PTR_MAX_PER_CALL = 12;

// AdGuard Home's query log directory, from its config (querylog.dir_path, else work_dir/data).
function querylog_files() {
	const c = cursor();
	const conf = c.get('adguardhome', 'config', 'config_file') ?? '/etc/adguardhome/adguardhome.yaml';
	const work = c.get('adguardhome', 'config', 'work_dir') ?? '/var/lib/adguardhome';
	let dir = null, in_ql = false;

	// Find querylog.dir_path in the YAML (top-level "querylog:" block, two-space indent).
	for (let l in split(readfile(conf) ?? '', '\n')) {
		if (match(l, /^[^ #]/))
			in_ql = (l == 'querylog:');
		else if (in_ql) {
			const m = match(l, /^  dir_path: *"?([^"]*)"?$/);
			if (m)
				dir = m[1];
		}
	}

	if (!dir || !length(dir))
		dir = `${work}/data`;

	return filter([ `${dir}/querylog.json.1`, `${dir}/querylog.json` ], (f) => stat(f) != null);
}

function u16(s, o) {
	return (ord(s, o) << 8) | ord(s, o + 1);
}

function skip_name(s, o) {
	for (let n = 0; n < 128 && o < length(s); n++) {
		const l = ord(s, o);
		if (l == 0)
			return o + 1;
		if ((l & 0xC0) == 0xC0)
			return o + 2;
		o += l + 1;
	}

	return -1;
}

// IPv4 addresses from the A records of a DNS response in wire format.
function a_records(msg) {
	const out = [];

	if (type(msg) != 'string' || length(msg) < 12)
		return out;

	const qd = u16(msg, 4), an = u16(msg, 6);
	let o = 12;

	for (let i = 0; i < qd && o >= 0; i++)
		o = skip_name(msg, o) + 4;

	for (let i = 0; i < an && o > 0 && o + 10 <= length(msg); i++) {
		o = skip_name(msg, o);
		if (o < 0 || o + 10 > length(msg))
			break;

		const t = u16(msg, o), rdlen = u16(msg, o + 8);
		o += 10;

		if (t == 1 && rdlen == 4 && o + 4 <= length(msg))
			push(out, sprintf('%d.%d.%d.%d', ord(msg, o), ord(msg, o + 1), ord(msg, o + 2), ord(msg, o + 3)));

		o += rdlen;
	}

	return out;
}

// addr -> queried name, newest wins. grep_client limits to one client's lookups.
function dns_names(files, wanted, grep_client) {
	const found = {};

	if (!length(files))
		return found;

	const sel = grep_client ? `grep -hF '"IP":"${grep_client}"' ${join(' ', files)}` : `cat ${join(' ', files)}`;

	for (let l in split(run(`${sel} 2>/dev/null | grep -F '"QT":"A"' | tail -n ${QUERYLOG_LINES}`), '\n')) {
		const qh = match(l, /"QH":"([^"]+)"/)?.[1];
		const ans = match(l, /"Answer":"([^"]+)"/)?.[1];
		if (!qh || !ans)
			continue;

		for (let a in a_records(b64dec(ans)))
			if (wanted[a])
				found[a] = qh;
	}

	return found;
}

function local_names() {
	const names = {};

	for (let l in split(readfile('/tmp/dhcp.leases') ?? '', '\n')) {
		const f = split(l, ' ');
		if (f[2] && f[3] && f[3] != '*')
			names[f[2]] = f[3];
	}

	cursor().foreach('dhcp', 'host', (s) => { if (s.ip && s.name) names[s.ip] = s.name; });
	cursor().foreach('network', 'interface', (s) => {
		// ipaddr is a string or a list, optionally with /prefix.
		for (let a in (type(s.ipaddr) == 'array' ? s.ipaddr : [ s.ipaddr ?? '' ])) {
			const ip = split(a, '/')[0];
			if (valid_ip(ip))
				names[ip] = trim(readfile('/proc/sys/kernel/hostname') ?? 'router');
		}
	});

	return names;
}

// Reverse DNS through the local resolver, in parallel, cached (including misses).
function ptr_names(addrs) {
	const file = `${STATE}/ptr.json`;
	let cache = {};
	try { cache = json(readfile(file) ?? '{}') ?? {}; } catch (e) { cache = {}; }

	const now = time();
	const todo = slice(filter(addrs, (a) => !cache[a] || now - cache[a].t > PTR_TTL), 0, PTR_MAX_PER_CALL);

	if (length(todo)) {
		let sh = '';
		for (let a in todo)
			sh += `( n=$(timeout 3 nslookup ${a} 127.0.0.1 2>/dev/null | sed -n 's/.*name = \\([^ ]*[^. ]\\)\\.\\{0,1\\}$/\\1/p' | head -n1); echo "${a} $n" ) &\n`;
		sh += 'wait\n';

		writefile(`${STATE}/ptr.sh`, sh);
		for (let l in split(run(`sh ${STATE}/ptr.sh`), '\n')) {
			const f = split(trim(l), ' ');
			if (valid_ip(f[0]))
				cache[f[0]] = { n: f[1] ?? '', t: now };
		}

		for (let a in todo)
			if (!cache[a])
				cache[a] = { n: '', t: now };

		// Keep the cache small.
		const ks = keys(cache);
		if (length(ks) > 2000)
			for (let k in slice(sort(ks, (x, y) => cache[x].t - cache[y].t), 0, length(ks) - 2000))
				delete cache[k];

		writefile(file, sprintf('%J', cache));
	}

	const out = {};
	for (let a in addrs)
		if (cache[a]?.n)
			out[a] = cache[a].n;

	return out;
}

// ---------------------------------------------------------------- methods

const methods = {
	rate: {
		args: { ip: '' },
		call: function(req) {
			const ip = req.args?.ip;
			if (!valid_ip(ip))
				return { error: 'invalid address' };

			mkdir(STATE);
			writefile(`${STATE}/seen.${ip}`, '');
			ensure_table();

			let rules = list_rules();
			if (!length(filter(rules, (r) => r.ip == ip))) {
				add_rules(ip);
				rules = list_rules();
			}

			const res = { ip: ip, uptime: uptime(), rx_bytes: 0, tx_bytes: 0, rx_packets: 0, tx_packets: 0, fresh: false };

			for (let r in rules)
				if (r.ip == ip) {
					res[`${r.dir}_bytes`] += r.bytes;
					res[`${r.dir}_packets`] += r.packets;
				}

			// This host's seen-file was just touched, so its rules always survive.
			garbage_collect(rules);
			return res;
		}
	},

	conns: {
		args: { ip: '' },
		call: function(req) {
			const ip = req.args?.ip;
			if (!valid_ip(ip))
				return { error: 'invalid address' };

			const fh = open('/proc/net/nf_conntrack', 'r');
			const conns = [];
			let total = 0;

			for (let l = fh?.read('line'); length(l); l = fh.read('line')) {
				if (index(l, `=${ip} `) < 0)
					continue;

				const f = split(trim(l), /\s+/);
				const c = { proto: f[2], state: null, assured: index(l, '[ASSURED]') >= 0 };
				const kv = [];
				let cur = null;

				// Two tuples: original then reply, each src dst [sport dport] packets bytes.
				for (let w in f) {
					const m = match(w, /^(src|dst|sport|dport|packets|bytes|type|code)=(.*)$/);
					if (m) {
						if (m[1] == 'src')
							push(kv, cur = {});
						cur[m[1]] = m[2];
					}
					else if (match(w, /^[A-Z_]+$/) && !c.state && w != 'ASSURED')
						c.state = w;
				}

				const o = kv[0] ?? {}, r = kv[1] ?? {};
				if (o.src != ip && o.dst != ip && r.src != ip && r.dst != ip)
					continue;

				total++;
				if (length(conns) >= MAX_CONNS)
					continue;

				// Outbound when the host started the flow (or is the reply source after DNAT).
				const outbound = (o.src == ip);
				push(conns, {
					proto: c.proto, state: c.state, assured: c.assured,
					direction: outbound ? 'out' : 'in',
					local_port: int(outbound ? o.sport : (r.src == ip ? r.sport : o.dport)),
					remote: outbound ? o.dst : o.src,
					remote_port: int(outbound ? o.dport : o.sport),
					tx_bytes: int(outbound ? o.bytes : r.bytes),
					rx_bytes: int(outbound ? r.bytes : o.bytes)
				});
			}

			fh?.close();
			return { ip: ip, total: total, conns: sort(conns, (a, b) => (b.rx_bytes + b.tx_bytes) - (a.rx_bytes + a.tx_bytes)) };
		}
	},

	host: {
		args: { ip: '' },
		call: function(req) {
			const ip = req.args?.ip;
			if (!valid_ip(ip))
				return { error: 'invalid address' };

			const lease = lease_for(ip);
			const neigh = neigh_for(ip);
			const mac = lease?.mac ?? neigh?.mac;

			return {
				ip: ip,
				lease: lease,
				static_lease: static_for(ip, mac),
				neigh: neigh,
				port: port_for(mac),
				nlbw: nlbw(ip),
				snort: snort_alerts(ip),
				addrwatch: addrwatch(ip, mac)
			};
		}
	},

	names: {
		args: { ip: '', addrs: [], ptr: true },
		call: function(req) {
			const ip = req.args?.ip;
			if (!valid_ip(ip))
				return { error: 'invalid address' };

			const addrs = slice(filter(req.args?.addrs ?? [], valid_ip), 0, 100);
			const res = {};
			let left = {};

			for (let a in addrs)
				left[a] = true;

			const take = (found, source) => {
				for (let a, n in found)
					if (left[a]) {
						res[a] = { name: n, source: source };
						delete left[a];
					}
			};

			take(local_names(), 'lan');

			const files = querylog_files();
			if (length(keys(left)))
				take(dns_names(files, left, ip), 'dns');
			if (length(keys(left)))
				take(dns_names(files, left, null), 'dns-other');
			if (req.args?.ptr !== false && length(keys(left))) {
				mkdir(STATE);
				take(ptr_names(filter(keys(left), (a) => !match(a, /^(255\.|0\.|22[4-9]\.|23\d\.)/))), 'ptr');
			}

			return { names: res, querylog: length(files) > 0 };
		}
	},

	crowdsec: {
		args: { ip: '' },
		call: function(req) {
			const ip = req.args?.ip;
			if (!valid_ip(ip))
				return { error: 'invalid address' };
			if (!stat('/usr/bin/cscli'))
				return { available: false };

			// --ip returns whole alerts (a CAPI hit carries every community decision): keep only this IP.
			const rows = [];
			for (let a in jrun(`/usr/bin/cscli decisions list -a --ip ${ip} -o json 2>/dev/null`) ?? [])
				for (let d in a?.decisions ?? [])
					if (d.value == ip || d.value == `${ip}/32`)
						push(rows, { type: d.type, origin: d.origin, scenario: d.scenario, duration: d.duration });

			return { available: true, decisions: rows };
		}
	}
};

return { 'luci.hostmon': methods };
